# Flask dashboard: set a long random value for FLASK_SECRET_KEY
FLASK_SECRET_KEY=replace-with-a-long-random-secret
DASHBOARD_USERNAME=change-me
DASHBOARD_PASSWORD=change-me-to-a-strong-password
HOST=127.0.0.1
PORT=5000
COOKIE_SECURE=false

# RFID reader
SERIAL_PORT=COM13
BAUD_RATE=115200
TEACHER_UID=REPLACE_WITH_TEACHER_CARD_UID

# Google Sheets integration
GOOGLE_SHEET_NAME=RFID
GOOGLE_CREDENTIALS=credentials/service-account.json

# Optional email reporting
TEACHER_EMAIL=
SENDER_EMAIL=
SENDER_PASSWORD=

# Optional UltraMsg WhatsApp alerts
ULTRAMSG_TOKEN=
ULTRAMSG_INSTANCE_ID=
WHATSAPP_TEACHER_NUMBER=

# Optional data locations
ATTENDANCE_CSV=attendance.csv
BACKUP_DIR=backups
